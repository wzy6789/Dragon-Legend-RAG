# ==== 推理服务（OpenAI 兼容）====
# 必填：服务端密钥（绝不提交 Git）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ==== 私有语料与索引（部署时通过卷挂载，仓库内不含资料）====
# JSONL 语料路径（由 scripts/prepare_corpus.py 生成）
RAG_DATA_PATH=/mnt/rag-data/corpus.jsonl
# FAISS 向量索引目录（可选）
VECTOR_INDEX_PATH=
EMBED_MODEL_NAME=BAAI/bge-m3

# ==== 上传（补充资料，私有存储）====
UPLOAD_DIR=./uploads
UPLOAD_ENABLE_INGEST=false

# ==== 跨域与会话 ====
CORS_ORIGINS=http://localhost:3000
MAX_HISTORY_TURNS=12
