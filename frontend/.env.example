# 后端 API 地址（浏览器直连；静态托管时在构建期注入）
#   - 本地 dev:   http://localhost:8000
#   - 生产:       后端部署域名，如 https://xxx.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub Pages 子路径（仓库名；仅 GitHub Pages 部署需要，其他平台留空）
#   https://<user>.github.io/Dragon-Legend-RAG/  →  /Dragon-Legend-RAG
NEXT_PUBLIC_BASE_PATH=/Dragon-Legend-RAG
